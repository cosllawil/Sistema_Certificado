RewriteEngine On

# URLs limpias del sistema.

# Entrada MVC pública.
RewriteRule ^$ public/index.php [L]
RewriteRule ^public/?$ public/ [L]
RewriteRule ^dashboard/?$ public/dashboard.php [L,QSA]
RewriteRule ^registrar_certificado/?$ public/registrar_certificado.php [L,QSA]
RewriteRule ^certificados/?$ public/certificados.php [L,QSA]
RewriteRule ^certificado_pdf/?$ public/certificado_pdf.php [L,QSA]
RewriteRule ^plantillas/?$ public/plantillas.php [L,QSA]
RewriteRule ^participantes/?$ public/participantes.php [L,QSA]
RewriteRule ^reniec/?$ public/reniec.php [L,QSA]
RewriteRule ^cursos/?$ public/cursos.php [L,QSA]
RewriteRule ^tipos_certificado/?$ public/tipos_certificado.php [L,QSA]
RewriteRule ^firmantes/?$ public/firmantes.php [L,QSA]
RewriteRule ^usuarios/?$ public/usuarios.php [L,QSA]
RewriteRule ^roles/?$ public/roles.php [L,QSA]
RewriteRule ^reportes/?$ public/reportes.php [L,QSA]
RewriteRule ^auditoria/?$ public/auditoria.php [L,QSA]
RewriteRule ^configuracion/?$ public/configuracion.php [L,QSA]
RewriteRule ^login/?$ public/index.php [L,QSA]
RewriteRule ^forgot_password/?$ public/forgot_password.php [L,QSA]
RewriteRule ^verificar/?$ public/verificar.php [L,QSA]
RewriteRule ^auth/login/?$ public/auth/login.php [L,QSA]
RewriteRule ^auth/logout/?$ public/auth/logout.php [L,QSA]
RewriteRule ^cambiar_contrasena/?$ public/cambiar_contrasena.php [L,QSA]

# Ocultar la extensión cuando se accede directamente al archivo PHP.
RewriteCond %{THE_REQUEST} \s/+Sistema_Certificado/dashboard\.php(?:[?\ ]|$) [NC]
RewriteRule ^dashboard\.php$ /Sistema_Certificado/dashboard [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+Sistema_Certificado/index\.php(?:[?\ ]|$) [NC]
RewriteRule ^index\.php$ /Sistema_Certificado/login [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+Sistema_Certificado/registrar_certificado\.php(?:[?\ ]|$) [NC]
RewriteRule ^registrar_certificado\.php$ /Sistema_Certificado/registrar_certificado [R=301,L,NE]

# Mantener los recursos reales (CSS, JS, imágenes, etc.).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rutas públicas sin extensión .php.
RewriteRule ^dashboard/?$ dashboard.php [L,QSA]
RewriteRule ^registrar_certificado/?$ registrar_certificado.php [L,QSA]
RewriteRule ^login/?$ index.php [L,QSA]

# Permitir que las rutas existentes de autenticación sigan funcionando.

# Si se solicita un PHP directamente, llevarlo a su URL limpia.
RewriteCond %{THE_REQUEST} \s/+Sistema_Certificado/([^?\ ]+)\.php(?:[?\ ]|$) [NC]
RewriteRule ^(.+)\.php$ /Sistema_Certificado/$1 [R=301,L,NE]
